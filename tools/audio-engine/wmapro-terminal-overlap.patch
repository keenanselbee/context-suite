--- a/libavcodec/wmaprodec.c
+++ b/libavcodec/wmaprodec.c
@@ -1446,6 +1446,8 @@
     GetBitContext* gb = &s->gb;
     int more_frames = 0;
     int len = 0;
+    int trim_end_present = 0;
+    int output_samples = s->samples_per_frame;
     int i;
 
     /** get frame length */
@@ -1478,7 +1480,8 @@
         if (get_bits1(gb))
             s->trim_start = get_bits(gb, av_log2(s->samples_per_frame * 2));
 
-        if (get_bits1(gb))
+        trim_end_present = get_bits1(gb);
+        if (trim_end_present)
             s->trim_end = get_bits(gb, av_log2(s->samples_per_frame * 2));
     } else {
         s->trim_start = s->trim_end = 0;
@@ -1503,10 +1506,21 @@
         }
     }
 
+    /* A terminal short block leaves valid overlap beyond the nominal frame.
+     * Include it before applying the bitstream's end trim. Use the largest
+     * channel block so every emitted channel has reconstructed samples. */
+    if (trim_end_present && s->avctx->codec_id == AV_CODEC_ID_WMAPRO) {
+        int last_block = 0;
+        for (i = 0; i < s->nb_channels; i++)
+            last_block = FFMAX(last_block, s->channel[i].prev_block_len);
+        output_samples += (s->samples_per_frame - last_block) / 2;
+    }
+    frame->nb_samples = output_samples;
+
     /** copy samples to the output buffer */
     for (i = 0; i < s->nb_channels; i++)
         memcpy(frame->extended_data[i], s->channel[i].out,
-               s->samples_per_frame * sizeof(*s->channel[i].out));
+               output_samples * sizeof(*s->channel[i].out));
 
     for (i = 0; i < s->nb_channels; i++) {
         /** reuse second half of the IMDCT output for the next frame */
@@ -1515,11 +1529,17 @@
                s->samples_per_frame * sizeof(*s->channel[i].out) >> 1);
     }
 
-    if (s->skip_frame) {
+    /* A one-frame stream may contain both priming and a valid terminal
+     * overlap. Its explicit trims take precedence over the usual first-frame
+     * discard when they leave nonempty reconstructed audio. */
+    if (s->skip_frame &&
+        !(s->avctx->codec_id == AV_CODEC_ID_WMAPRO && trim_end_present &&
+          s->trim_start && s->trim_start + s->trim_end < output_samples)) {
         s->skip_frame = 0;
         *got_frame_ptr = 0;
         av_frame_unref(frame);
     } else {
+        s->skip_frame = 0;
         *got_frame_ptr = 1;
     }
 
@@ -1819,12 +1839,13 @@
     WMAProDecodeCtx *s = avctx->priv_data;
     int ret;
 
-    /* get output buffer */
-    frame->nb_samples = s->samples_per_frame;
+    /* Reserve room for a terminal frame's reconstructed overlap. */
+    frame->nb_samples = s->samples_per_frame + s->samples_per_frame / 2;
     if ((ret = ff_get_buffer(avctx, frame, 0)) < 0) {
         s->packet_loss = 1;
         return 0;
     }
+    frame->nb_samples = s->samples_per_frame;
 
     return decode_packet(avctx, s, frame, got_frame_ptr, avpkt);
 }
