<Project>
  <PropertyGroup>
    <ContextSuitePrivateProject Condition="'$(ContextSuitePrivateProject)' == ''">$(MSBuildThisFileDirectory)..\proprietary\src\ContextSuite.Private\ContextSuite.Private.csproj</ContextSuitePrivateProject>
  </PropertyGroup>
  <!-- The UI requires the private checkout/worker for the product build, but must not
       acquire a transitive native image-engine dependency. Only the worker links it. -->
  <ItemGroup Condition="Exists('$(ContextSuitePrivateProject)') and '$(ContextSuitePrivateBuildOnly)' != 'true'">
    <ProjectReference Include="$(ContextSuitePrivateProject)" />
  </ItemGroup>
  <Target Name="RequirePrivateCheckout" BeforeTargets="PrepareForBuild;CollectPackageReferences">
    <Error Condition="!Exists('$(ContextSuitePrivateProject)')" Text="Context Suite production requires the compatible context-suite-private checkout under proprietary/. See docs/development.md. There is no public demo build." />
  </Target>
</Project>
