+    {
+        const OUString attribute = xAttribs->getNameByIndex(index);
+        if (attribute == "xmlns")
+            namespaces[OUString()] = xAttribs->getValueByIndex(index);
+        else if (attribute.startsWith("xmlns:"))
+            namespaces[attribute.copy(6)] = xAttribs->getValueByIndex(index);
