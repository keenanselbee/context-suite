<Window x:Class="ContextSuite.Application.OfficeFontReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Context Suite — Review PDF fonts" Width="560" MinWidth="440"
        MinHeight="280" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="OfficeFontReviewWindow">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Some fonts were replaced" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,12,0,20">
            <StackPanel>
                <TextBlock x:Name="SourceName" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="These fonts weren't available to the converter. The PDF may look different:" TextWrapping="Wrap" Margin="0,12,0,8" />
                <TextBlock x:Name="FontNames" TextWrapping="Wrap" AutomationProperties.AutomationId="OfficeMissingFonts" />
                <TextBlock Text="Save the PDF with substitute fonts, or skip this file. Your original is kept." TextWrapping="Wrap" Margin="0,16,0,0" />
            </StackPanel>
        </ScrollViewer>
        <WrapPanel Grid.Row="2" HorizontalAlignment="Right">
            <Button x:Name="SkipFile" Content="S_kip file" Click="OnSkip" IsCancel="True" Padding="12,6" Margin="0,0,8,0" AutomationProperties.AutomationId="OfficeFontsSkip" />
            <Button Content="_Save PDF copy" Click="OnSave" Padding="12,6" AutomationProperties.AutomationId="OfficeFontsSave" />
        </WrapPanel>
    </Grid>
</Window>
