<Window x:Class="ContextSuite.Application.AudioConversionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ContextSuite.Application.Infrastructure"
        Title="Context Suite — Audio conversion" Width="600" MinWidth="440" MinHeight="280"
        SizeToContent="Height" WindowStartupLocation="CenterOwner" AutomationProperties.AutomationId="AudioConversionWindow">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding Heading}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      AutomationProperties.AutomationId="AudioConversionBody">
        <StackPanel>
            <TextBlock Text="{Binding FileSummary}" Margin="0,8,0,16" />
            <TextBlock Text="Review these audio changes" FontWeight="SemiBold" />
            <TextBlock Text="{Binding QualityChanges}" TextWrapping="Wrap" Margin="0,8,0,16" AutomationProperties.AutomationId="AudioQualityChanges" />
            <TextBlock Text="{Binding OutputSummary}" TextWrapping="Wrap" />
            <Expander Header="Files" IsExpanded="False" Margin="0,16,0,16" AutomationProperties.AutomationId="AudioConversionFiles">
                <TextBlock Text="{Binding FileNames}" TextWrapping="Wrap" Margin="8" />
            </Expander>
        </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <ui:StatusTextBlock Text="{Binding Message}" TextWrapping="Wrap" AutomationProperties.AutomationId="AudioConversionStatus" />
            <WrapPanel HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="{Binding LicenseActionLabel}" Click="OnLicense" Padding="12,6" Margin="0,0,8,0" AutomationProperties.AutomationId="AudioConversionLicense" />
                <Button Content="_Convert" Command="{Binding ConfirmCommand}" Padding="12,6" Margin="0,0,8,0" AutomationProperties.AutomationId="ConfirmAudioConversion" />
                <Button Content="_Cancel" Click="OnCancel" IsCancel="True" Padding="12,6" AutomationProperties.AutomationId="CancelAudioConversion" />
            </WrapPanel>
        </StackPanel>
    </Grid>
</Window>
