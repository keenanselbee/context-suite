<Window x:Class="ContextSuite.Application.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ContextSuite.Application.Infrastructure"
        Title="Context Suite - Settings" Width="670" Height="550" MinWidth="620" MinHeight="490"
        WindowStartupLocation="CenterOwner" AutomationProperties.AutomationId="SettingsWindow">
    <Window.Resources>
        <DataTemplate x:Key="ToolPreferences">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16">
                <Label Content="_Output folder (blank uses the source folder)" Target="{Binding ElementName=OutputFolder}" Padding="0,0,0,6" />
                <DockPanel>
                <Button DockPanel.Dock="Right" Content="_Browse..." Click="OnBrowseFolder" Padding="12,6" Margin="8,0,0,0"
                        AutomationProperties.AutomationId="BrowseOutputFolder" />
                <TextBox x:Name="OutputFolder" Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.AutomationId="OutputFolder" AutomationProperties.Name="Output folder"
                         Padding="6" />
                </DockPanel>
                <TextBlock Text="Choosing another folder always keeps originals." Margin="0,8,0,20" TextWrapping="Wrap" />
                <CheckBox Content="_Allow replacing originals"
                          IsChecked="{Binding AllowReplacingOriginals}"
                          IsEnabled="{Binding DataContext.CanAllowReplacement, RelativeSource={RelativeSource AncestorType=Window}}"
                          AutomationProperties.AutomationId="AllowReplacement" />
                <TextBlock Text="{Binding DataContext.ReplacementNotice, RelativeSource={RelativeSource AncestorType=Window}}"
                           Margin="0,8,0,0" TextWrapping="Wrap" />
            </StackPanel>
            </ScrollViewer>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16" />
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedSection}" IsEnabled="{Binding CanEdit}"
                    AutomationProperties.AutomationId="SettingsSections">
            <TabItem Header="_Convert" AutomationProperties.AutomationId="ConvertSettings">
                <ContentControl Content="{Binding Convert}" ContentTemplate="{StaticResource ToolPreferences}" />
            </TabItem>
            <TabItem Header="_Optimize" AutomationProperties.AutomationId="OptimizeSettings">
                <ContentControl Content="{Binding Optimize}" ContentTemplate="{StaticResource ToolPreferences}" />
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <CheckBox Content="Play a completion _sound for quick actions" IsChecked="{Binding PlayCompletionSound}" IsEnabled="{Binding CanEdit}"
                      AutomationProperties.AutomationId="PlayCompletionSound" Margin="0,0,0,12" />
            <TextBlock Text="New-file naming" FontWeight="SemiBold" />
            <TextBlock Text="{Binding NamingExample}" Margin="0,4,0,0" />
            <TextBlock Text="Existing names are preserved. Collisions add (2), (3), and so on." TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
        <ui:StatusTextBlock Grid.Row="3" Text="{Binding Message}" TextWrapping="Wrap" Margin="0,12,0,0"
                   AutomationProperties.AutomationId="SettingsMessage" AutomationProperties.LiveSetting="Polite" />
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="_Save" Command="{Binding SaveCommand}" IsDefault="True" Padding="18,6" Margin="0,0,8,0"
                    AutomationProperties.AutomationId="SaveSettings" />
            <Button Content="_Cancel" Click="OnCancel" IsCancel="True" Padding="18,6"
                    AutomationProperties.AutomationId="CancelSettings" />
        </StackPanel>
    </Grid>
</Window>
