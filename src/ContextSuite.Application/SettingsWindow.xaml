<Window x:Class="ContextSuite.Application.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ContextSuite.Application.Infrastructure"
        Title="Context Suite - Settings" Width="680" Height="660" MinWidth="560" MinHeight="480" FontSize="14"
        WindowStartupLocation="CenterOwner" AutomationProperties.AutomationId="SettingsWindow">
    <Window.Resources>
        <DataTemplate x:Key="SettingsTabHeader">
            <Border Padding="14,8" Margin="0,0,8,0" BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TabItem}}" Value="True">
                                <Setter Property="BorderThickness" Value="0,0,0,3" />
                                <Setter Property="TextElement.FontWeight" Value="Bold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <AccessText Text="{Binding}" />
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="ToolPreferences">
            <Border BorderThickness="1" CornerRadius="4" Margin="0,8,0,0"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}">
            <StackPanel Margin="16">
                <TextBlock Text="{Binding DataContext.SectionHeading, RelativeSource={RelativeSource AncestorType=Window}}"
                           FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16" AutomationProperties.AutomationId="SettingsSectionHeading" />
                <TextBlock Text="Original files" FontWeight="SemiBold" Margin="0,0,0,12" />
                <RadioButton Content="Create _copies (default)" IsChecked="{Binding CreateCopies}"
                             AutomationProperties.AutomationId="CreateCopies" />
                <TextBlock Text="Keep originals and save a new file for each result." TextWrapping="Wrap" Margin="26,6,0,16" />
                <RadioButton Content="_Overwrite originals" IsChecked="{Binding ReplaceOriginals}"
                             IsEnabled="{Binding DataContext.CanAllowReplacement, RelativeSource={RelativeSource AncestorType=Window}}"
                             AutomationProperties.AutomationId="AllowReplacement" />
                <TextBlock Text="{Binding DataContext.ReplacementNotice, RelativeSource={RelativeSource AncestorType=Window}}"
                           TextWrapping="Wrap" Margin="26,6,0,8" AutomationProperties.AutomationId="OverwriteExplanation" />
                <Expander Header="Copy _location and names" Margin="0,16,0,0" AutomationProperties.AutomationId="CopyOptions">
                    <StackPanel Margin="4,12,4,0">
                        <Label Content="Save copies _to" Target="{Binding ElementName=OutputFolder}" Padding="0,0,0,6" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="_Browse..." Click="OnBrowseFolder" Padding="12,6" Margin="8,0,0,0"
                                    AutomationProperties.AutomationId="BrowseOutputFolder" />
                            <TextBox x:Name="OutputFolder" Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}" Padding="6"
                                     AutomationProperties.AutomationId="OutputFolder" AutomationProperties.Name="Output folder" />
                        </DockPanel>
                        <TextBlock Text="Leave blank to save beside each original. Choosing another folder always creates copies."
                                   TextWrapping="Wrap" Margin="0,8,0,16" />
                        <TextBlock Text="Copy names" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding DataContext.NamingExample, RelativeSource={RelativeSource AncestorType=Window}}"
                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock Text="If a name already exists, we add (2), (3), and so on." TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Expander>
            </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Right-click files in Explorer to Convert, Optimize or Analyze."
                       TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      AutomationProperties.AutomationId="SettingsBody">
            <StackPanel>
                <TabControl SelectedIndex="{Binding SelectedSection}" IsEnabled="{Binding CanEdit}"
                            AutomationProperties.AutomationId="SettingsSections">
                    <TabItem Header="_Convert" HeaderTemplate="{StaticResource SettingsTabHeader}" AutomationProperties.AutomationId="ConvertSettings">
                        <ContentControl Content="{Binding Convert}" ContentTemplate="{StaticResource ToolPreferences}" />
                    </TabItem>
                    <TabItem Header="_Optimize" HeaderTemplate="{StaticResource SettingsTabHeader}" AutomationProperties.AutomationId="OptimizeSettings">
                        <ContentControl Content="{Binding Optimize}" ContentTemplate="{StaticResource ToolPreferences}" />
                    </TabItem>
                </TabControl>
                <CheckBox Content="Play a _sound when work finishes" IsChecked="{Binding PlayCompletionSound}" IsEnabled="{Binding CanEdit}"
                          AutomationProperties.AutomationId="PlayCompletionSound" Margin="0,24,0,12" />
            </StackPanel>
        </ScrollViewer>
        <ui:StatusTextBlock Grid.Row="2" Text="{Binding Message}" TextWrapping="Wrap" Margin="0,16,0,0"
                           AutomationProperties.AutomationId="SettingsMessage" AutomationProperties.LiveSetting="Polite" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="_License..." Click="OnLicense" Padding="18,6" Margin="0,0,8,0" AutomationProperties.AutomationId="SettingsLicense" />
            <Button Content="_Save" Command="{Binding SaveCommand}" IsDefault="True" Padding="18,6" Margin="0,0,8,0"
                    AutomationProperties.AutomationId="SaveSettings" />
            <Button Content="_Cancel" Click="OnCancel" IsCancel="True" Padding="18,6" AutomationProperties.AutomationId="CancelSettings" />
        </StackPanel>
    </Grid>
</Window>
