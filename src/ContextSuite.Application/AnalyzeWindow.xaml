<Window x:Class="ContextSuite.Application.AnalyzeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ContextSuite.Application"
        xmlns:ui="clr-namespace:ContextSuite.Application.Infrastructure"
        Title="Analyze — Context Suite" AutomationProperties.AutomationId="AnalyzeWindow"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Width="760" Height="570" MinWidth="560" MinHeight="380">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
            <TextBlock Text="Analyze" FontSize="14" FontWeight="SemiBold" />
            <TextBlock Text="Read-only · No files changed" FontSize="12" Margin="0,4,0,0" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <ui:StatusTextBlock x:Name="InputNotice" TextWrapping="Wrap" Margin="0,0,0,8"
                                AutomationProperties.LiveSetting="Polite" />
            <WrapPanel HorizontalAlignment="Right">
                <Button Content="Show in _folder" Click="OnShowAnalysisFile" Padding="12,6" Margin="0,0,8,0"
                        IsEnabled="{Binding HasSelectedAnalysis}" AutomationProperties.AutomationId="ShowAnalysisFile" />
                <Button Content="{Binding AnalysisCopyLabel}" Click="OnCopyAnalysis" Padding="12,6" Margin="0,0,8,0"
                        IsEnabled="{Binding HasSelectedAnalysis}" AutomationProperties.AutomationId="CopyAnalysis" />
                <Button Content="_Close" Click="OnClose" IsCancel="True" Padding="12,6"
                        AutomationProperties.AutomationId="CloseAnalysis" />
            </WrapPanel>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <local:AnalyzeView />
        </ScrollViewer>
    </DockPanel>
</Window>
