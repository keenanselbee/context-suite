<Window x:Class="ContextSuite.Application.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Context Suite" Width="850" Height="540" MinWidth="620" MinHeight="380">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Context Suite" FontSize="26" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Margin="0,12,0,16" TextWrapping="Wrap"
                   Text="Production foundation: Explorer selections are received as batches. Media analysis, conversion, and optimization are not implemented yet. No files will be changed." />
        <DataGrid Grid.Row="2" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" AutomationProperties.Name="Selected files and operation results">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Batch" Binding="{Binding Batch}" Width="70" />
                <DataGridTextColumn Header="Tool" Binding="{Binding Operation}" Width="90" />
                <DataGridTextColumn Header="File" Binding="{Binding Path}" Width="*" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="220" />
            </DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="3" Margin="0,16,0,0">
            <Button DockPanel.Dock="Right" Content="_Cancel pending" Command="{Binding CancelCommand}" Padding="12,6" Margin="12,0,0,0" />
            <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>
    </Grid>
</Window>
