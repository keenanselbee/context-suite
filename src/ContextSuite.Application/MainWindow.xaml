<Window x:Class="ContextSuite.Application.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Context Suite" AutomationProperties.AutomationId="ContextSuiteWindow"
        Width="1000" Height="620" MinWidth="700" MinHeight="440" AllowDrop="True" PreviewDrop="OnFilesDropped" PreviewDragOver="OnDragOver">
    <Grid Margin="20" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Context Suite" FontSize="26" FontWeight="SemiBold" />
            <WrapPanel HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="_Settings..." Command="{Binding SettingsCommand}"
                    AutomationProperties.AutomationId="OpenSettings" Padding="12,6" HorizontalAlignment="Right" />
            <Button Content="_Convert files..." Click="OnChooseFiles" Margin="8,0,0,0"
                    AutomationProperties.AutomationId="ChooseConversionFiles" Padding="12,6" HorizontalAlignment="Right" />
            <Button Content="_Analyze DDS..." Click="OnChooseAnalysisFiles" Margin="8,0,0,0"
                    AutomationProperties.AutomationId="ChooseAnalysisFiles" Padding="12,6" HorizontalAlignment="Right" />
            <Button Content="_Optimize PNG..." Click="OnChooseOptimizationFiles" Margin="8,0,0,0"
                    AutomationProperties.AutomationId="ChooseOptimizationFiles" Padding="12,6" />
            </WrapPanel>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,12,0,16">
            <TextBlock TextWrapping="Wrap"
                       Text="Convert PNG, JPEG, WebP, BMP, TGA and supported 2D DDS textures; optimize PNG losslessly; or analyze DDS headers without changing files. Drop files here to convert. Select a result row to read its details. Optimization keeps originals by default and saves only smaller verified results." />
            <TextBlock Text="{Binding RecoveryNotice}" TextWrapping="Wrap" AutomationProperties.AutomationId="RecoveryNotice" />
            <TextBlock x:Name="InputNotice" TextWrapping="Wrap" AutomationProperties.AutomationId="InputNotice" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
        <DataGrid x:Name="ResultsGrid" Grid.Row="2" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" AutomationProperties.AutomationId="BatchResults"
                  AutomationProperties.Name="Selected files and operation results">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Batch" Binding="{Binding Batch}" Width="70" />
                <DataGridTextColumn Header="Tool" Binding="{Binding Operation}" Width="90" />
                <DataGridTextColumn Header="File" Binding="{Binding Path}" Width="*" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="220" />
                <DataGridTextColumn Header="Output" Binding="{Binding OutputPath}" Width="SizeToHeader" />
                <DataGridTextColumn Header="Retained original" Binding="{Binding RetainedOriginalPath}" Width="SizeToHeader" />
                <DataGridTextColumn Header="Recovery record" Binding="{Binding RecoveryRecordPath}" Width="SizeToHeader" />
            </DataGrid.Columns>
        </DataGrid>
        <ScrollViewer Grid.Row="3" MaxHeight="120" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
            <TextBlock Text="{Binding SelectedItem.ResultDetails, ElementName=ResultsGrid}" TextWrapping="Wrap" FontSize="12"
                       AutomationProperties.AutomationId="SelectedResultDetails" />
        </ScrollViewer>
        <DockPanel Grid.Row="4" Margin="0,16,0,0">
            <Button DockPanel.Dock="Right" AutomationProperties.AutomationId="CancelPending"
                    Content="Cancel _pending" Command="{Binding CancelCommand}" Padding="12,6" Margin="12,0,0,0" />
            <Button DockPanel.Dock="Right" Content="Open output _folder" Click="OnOpenOutputFolder" Padding="10,6" Margin="8,0,0,0"
                    AutomationProperties.AutomationId="OpenOutputFolder" />
            <Button DockPanel.Dock="Right" Content="_Retry selected" Click="OnRetrySelected" Padding="10,6" Margin="8,0,0,0"
                    AutomationProperties.AutomationId="RetrySelectedFiles" />
            <TextBlock Text="{Binding Summary}" AutomationProperties.AutomationId="BatchSummary"
                       VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>
    </Grid>
</Window>
