<Window x:Class="ContextSuite.Application.OfficeCalculationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Context Suite — Spreadsheet PDF" Width="560" MinWidth="440" MinHeight="260"
        SizeToContent="Height" WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="OfficeCalculationWindow">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Spreadsheet formulas" FontSize="24" FontWeight="SemiBold" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,12,0,20">
            <StackPanel>
                <TextBlock Text="Choose which formula results to show in the PDF copies. This choice applies to the selected spreadsheets; originals are kept." TextWrapping="Wrap" />
                <TextBlock Text="Saved values use the results stored when the workbook was last saved. These may be out of date." TextWrapping="Wrap" Margin="0,12,0,0" />
                <TextBlock Text="Recalculate evaluates supported formulas locally before exporting. Results may change. External data is not refreshed." TextWrapping="Wrap" Margin="0,12,0,0" />
            </StackPanel>
        </ScrollViewer>
        <WrapPanel Grid.Row="2" HorizontalAlignment="Right">
            <Button x:Name="SavedValues" Content="Use _saved values" Click="OnSaved" Padding="12,6" Margin="0,0,8,0" AutomationProperties.AutomationId="OfficeSavedValues" />
            <Button Content="_Recalculate" Click="OnRecalculate" Padding="12,6" Margin="0,0,8,0" AutomationProperties.AutomationId="OfficeRecalculate" />
            <Button Content="Cancel" Click="OnCancel" IsCancel="True" Padding="12,6" AutomationProperties.AutomationId="OfficeCalculationCancel" />
        </WrapPanel>
    </Grid>
</Window>
