<Window x:Class="ContextSuite.Application.ImagePdfOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ContextSuite.Application.Infrastructure"
        Title="Context Suite — PDF page order" Width="640" MinWidth="440" MinHeight="320"
        SizeToContent="Height" WindowStartupLocation="CenterOwner" AutomationProperties.AutomationId="ImagePdfOrderWindow">
    <Window.InputBindings>
        <KeyBinding Key="Up" Modifiers="Alt" Command="{Binding MoveUpCommand}" />
        <KeyBinding Key="Down" Modifiers="Alt" Command="{Binding MoveDownCommand}" />
    </Window.InputBindings>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Page order" FontSize="24" FontWeight="SemiBold" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      AutomationProperties.AutomationId="ImagePdfOrderBody">
            <StackPanel>
                <TextBlock Text="{Binding FileSummary}" Margin="0,8,0,12" />
                <TextBlock Text="The top image becomes page 1. Review this order before converting." TextWrapping="Wrap" />
                <ListBox x:Name="PageList" ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage, Mode=TwoWay}"
                         SelectionMode="Single" MaxHeight="280" Margin="0,12,0,8" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         AutomationProperties.AutomationId="ImagePdfPages" AutomationProperties.Name="PDF pages in order">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Number}" FontWeight="SemiBold" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Folder}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <WrapPanel>
                    <Button Content="Move _up" Command="{Binding MoveUpCommand}" Padding="12,6" Margin="0,0,8,0"
                            AutomationProperties.AutomationId="ImagePdfMoveUp" />
                    <Button Content="Move _down" Command="{Binding MoveDownCommand}" Padding="12,6"
                            AutomationProperties.AutomationId="ImagePdfMoveDown" />
                </WrapPanel>
                <TextBlock Text="Keyboard: select an image, then use Alt+Up or Alt+Down." TextWrapping="Wrap" Margin="0,8,0,16" />
                <TextBlock Text="Save PDF copy as" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Destination}" TextWrapping="Wrap" Margin="0,6,0,6" AutomationProperties.AutomationId="ImagePdfDestination" />
                <TextBlock Text="The name follows the first image. If it already exists, a number is added." TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <ui:StatusTextBlock Text="{Binding Message}" TextWrapping="Wrap" AutomationProperties.AutomationId="ImagePdfOrderStatus" />
            <WrapPanel HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="{Binding LicenseActionLabel}" Click="OnLicense" Padding="12,6" Margin="0,0,8,0" AutomationProperties.AutomationId="ImagePdfOrderLicense" />
                <Button Content="_Convert" Command="{Binding ConfirmCommand}" Padding="12,6" Margin="0,0,8,0" AutomationProperties.AutomationId="ConfirmImagePdf" />
                <Button Content="Cancel" Click="OnCancel" IsCancel="True" Padding="12,6" AutomationProperties.AutomationId="CancelImagePdf" />
            </WrapPanel>
        </StackPanel>
    </Grid>
</Window>
