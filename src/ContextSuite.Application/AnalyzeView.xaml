<UserControl x:Class="ContextSuite.Application.AnalyzeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:ContextSuite.Application.Infrastructure"
             AutomationProperties.AutomationId="AnalyzeView">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
        <!-- Disclosure changes affect layout immediately, without a sliding body
             that keeps the scroll range alive after the window has shrunk. -->
        <ControlTemplate x:Key="InstantDetailsTemplate" TargetType="Expander">
            <StackPanel>
                <ToggleButton x:Name="DetailsHeader" Padding="11" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              Background="{DynamicResource ExpanderHeaderBackground}"
                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                              AutomationProperties.Name="Technical details">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <ContentPresenter Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          RecognizesAccessKey="True" />
                        <Path x:Name="DetailsChevron" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                              Data="M 0,0 L 4,4 L 8,0" StrokeThickness="1"
                              Stroke="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Grid>
                </ToggleButton>
                <Border x:Name="DetailsBody" Visibility="Collapsed" Padding="11"
                        Background="{DynamicResource ExpanderContentBackground}"
                        BorderBrush="{DynamicResource ExpanderHeaderBorderBrush}" BorderThickness="1,0,1,1"
                        CornerRadius="0,0,4,4">
                    <ContentPresenter ContentSource="Content" />
                </Border>
            </StackPanel>
            <ControlTemplate.Triggers>
                <Trigger Property="IsExpanded" Value="True">
                    <Setter TargetName="DetailsBody" Property="Visibility" Value="Visible" />
                    <Setter TargetName="DetailsChevron" Property="Data" Value="M 0,4 L 4,0 L 8,4" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="FactLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.8" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="AnalysisCell" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="4,6" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>
        <Style x:Key="AnalysisRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AnalysisGridCell" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AnalysisHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource ApplicationBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <ui:StatusTextBlock Text="{Binding AnalysisStatus}" TextWrapping="Wrap" Margin="0,0,0,10"
                            AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="AnalysisStatus">
            <ui:StatusTextBlock.Style>
                <Style TargetType="ui:StatusTextBlock">
                    <Style.Triggers>
                        <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                    </Style.Triggers>
                </Style>
            </ui:StatusTextBlock.Style>
        </ui:StatusTextBlock>
        <DataGrid ItemsSource="{Binding AnalysisRows}" SelectedItem="{Binding SelectedAnalysisRow, Mode=TwoWay}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single"
                  MaxHeight="240" Margin="0,0,0,22" HeadersVisibility="Column"
                  Background="Transparent" RowBackground="Transparent" GridLinesVisibility="None"
                  BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" RowStyle="{StaticResource AnalysisRow}"
                  CellStyle="{StaticResource AnalysisGridCell}" ColumnHeaderStyle="{StaticResource AnalysisHeader}"
                  Visibility="{Binding HasMultipleAnalysisFiles, Converter={StaticResource VisibleWhenTrue}}"
                  AutomationProperties.Name="Analyzed files" AutomationProperties.AutomationId="AnalysisFiles">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="File" Width="1.3*" MinWidth="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,6">
                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding AnalysisType}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Details" Binding="{Binding AnalysisKeyInformation}" Width="1.2*" MinWidth="110" ElementStyle="{StaticResource AnalysisCell}" />
                <DataGridTextColumn Header="Size" Binding="{Binding AnalysisFileSize}" Width="90" ElementStyle="{StaticResource AnalysisCell}" />
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel DataContext="{Binding SelectedAnalysisRow}">
            <TextBlock Text="{Binding Name}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="AnalysisFilename" />
            <TextBlock Text="{Binding AnalysisType}" FontSize="14" Margin="0,5,0,12" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="AnalysisType" />
            <Border BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="3,0,0,0"
                    Padding="12,8" Margin="0,0,0,16"
                    Visibility="{Binding HasAnalysisNotice, Converter={StaticResource VisibleWhenTrue}}">
                <ui:StatusTextBlock Text="{Binding AnalysisNotice}" TextWrapping="Wrap"
                                    AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="AnalysisWarnings" />
            </Border>
            <ItemsControl ItemsSource="{Binding AnalysisPresentation.Highlights}" AutomationProperties.AutomationId="AnalysisHighlights">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="1"
                                CornerRadius="4" Padding="14" Margin="0,0,10,16" Width="202">
                            <StackPanel>
                                <TextBlock Text="{Binding Label}" Style="{StaticResource FactLabel}" />
                                <TextBlock Text="{Binding Value}" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,5" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Detail}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource FactLabel}">
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding AnalysisPresentation.Description}" TextWrapping="Wrap" Margin="0,0,0,20"
                       AutomationProperties.AutomationId="AnalysisDescription" />
            <TextBlock Text="Location" Style="{StaticResource FactLabel}" />
            <TextBlock Text="{Binding AnalysisLocation}" TextWrapping="Wrap" Margin="0,4,0,18"
                       AutomationProperties.AutomationId="AnalysisLocation" />
            <Expander Header="Technical details" Template="{StaticResource InstantDetailsTemplate}"
                      IsExpanded="{Binding DetailsExpanded, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                      Visibility="{Binding HasAnalysis, Converter={StaticResource VisibleWhenTrue}}"
                      AutomationProperties.AutomationId="AnalysisTechnicalDetails">
                <ItemsControl ItemsSource="{Binding AnalysisPresentation.TechnicalDetails}" Margin="0,12,0,0"
                              AutomationProperties.AutomationId="AnalysisFacts">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" Margin="0,0,16,0" />
                                                <TextBlock Text="{Binding Value}" Grid.Column="1" TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>
        </StackPanel>
    </StackPanel>
</UserControl>
