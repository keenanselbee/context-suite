<Window x:Class="ContextSuite.Application.OptimizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Context Suite — Optimize PNG" AutomationProperties.AutomationId="OptimizationWindow"
        Width="900" Height="570" MinWidth="680" MinHeight="470"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="PNG optimization" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding Preset}" Width="200" HorizontalAlignment="Left"
                      AutomationProperties.Name="PNG optimization preset" AutomationProperties.AutomationId="PngOptimizationPreset"/>
            <TextBlock Text="{Binding PolicyDescription}" TextWrapping="Wrap" Margin="0,8,0,4"/>
            <TextBlock TextWrapping="Wrap" Text="Originals are kept by default. No smaller acceptable result means no output. Lossy presets require supported 8-bit RGB/RGBA PNGs and must beat lossless recompression. Animation and interlacing are not supported."/>
        </StackPanel>
        <DataGrid Grid.Row="2" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" AutomationProperties.Name="PNG optimization plan">
            <DataGrid.Columns>
                <DataGridTextColumn Header="File" Binding="{Binding Name}" Width="140"/>
                <DataGridTextColumn Header="Properties" Binding="{Binding Details}" Width="190"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                <DataGridTextColumn Header="Proposed output (collision numbers may change)" Binding="{Binding ProposedOutput}" Width="220"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <CheckBox Content="Replace originals after validation (requires permission in Optimize settings)"
                      IsEnabled="{Binding CanReplaceOriginal}" IsChecked="{Binding ReplaceOriginal}" Margin="0,0,0,8"/>
            <CheckBox Content="I confirm replacement. Recycle originals only after success; retain backups if recycling fails."
                      IsEnabled="{Binding ReplaceOriginal}" IsChecked="{Binding ReplacementConfirmed}"/>
        </StackPanel>
        <StackPanel Grid.Row="4" Margin="0,12,0,12">
            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" AutomationProperties.AutomationId="OptimizationPlanStatus"/>
            <TextBlock Text="{Binding TrialMessage}" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" Click="Cancel_Click" MinWidth="90" Margin="0,0,10,0"/>
            <Button Content="Optimize" Command="{Binding ConfirmCommand}" MinWidth="160" Padding="12,6"
                    AutomationProperties.Name="Start PNG optimization" AutomationProperties.AutomationId="ConfirmPngOptimization"/>
        </StackPanel>
    </Grid>
</Window>
