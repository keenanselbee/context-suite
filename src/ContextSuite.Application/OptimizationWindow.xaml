<Window x:Class="ContextSuite.Application.OptimizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ContextSuite.Application.Infrastructure"
        Title="Context Suite — Optimize PNG" AutomationProperties.AutomationId="OptimizationWindow"
        Width="760" Height="600" MinWidth="600" MinHeight="440"
        WindowStartupLocation="CenterOwner" FocusManager.FocusedElement="{Binding ElementName=PresetChoice}">
    <Window.Resources><BooleanToVisibilityConverter x:Key="VisibleWhenTrue" /></Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="PNG optimization" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      AutomationProperties.AutomationId="OptimizationBody">
        <StackPanel Margin="0,0,10,0">
            <Label Content="_Preset" Target="{Binding ElementName=PresetChoice}" Padding="0,0,0,5" />
            <ComboBox x:Name="PresetChoice" ItemsSource="{Binding Presets}" SelectedItem="{Binding Preset}" MinHeight="32"
                      AutomationProperties.Name="PNG optimization preset" AutomationProperties.AutomationId="PngOptimizationPreset"/>
            <TextBlock Text="{Binding PolicyDescription}" TextWrapping="Wrap" Margin="0,8,0,4"/>
            <TextBlock TextWrapping="Wrap" Text="Originals are kept by default. Each preset selects the smallest eligible result, including a lossless fallback. No smaller result means no new file."/>
            <ui:StatusTextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,12,0,8"
                                AutomationProperties.AutomationId="OptimizationPlanStatus"/>
        <DataGrid ItemsSource="{Binding Rows}" SelectedIndex="{Binding SelectedIndex}" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" Height="150" CanUserAddRows="False" AutomationProperties.AutomationId="OptimizationFiles"
                  AutomationProperties.Name="PNG optimization plan">
            <DataGrid.Columns>
                <DataGridTextColumn Header="File" Binding="{Binding Name}" Width="160"/>
                <DataGridTextColumn Header="Plan" Binding="{Binding Status}" Width="*" MinWidth="160"/>
            </DataGrid.Columns>
        </DataGrid>
            <TextBlock Text="{Binding SelectedStatus}" TextWrapping="Wrap" Margin="0,6,0,0"
                       AutomationProperties.AutomationId="SelectedOptimizationStatus" />
            <Expander Header="File _details" Margin="0,8,0,0" AutomationProperties.AutomationId="OptimizationDetails">
                <TextBlock Text="{Binding SelectedDetails}" TextWrapping="Wrap" Margin="4,8"
                           AutomationProperties.AutomationId="SelectedOptimizationDetails" />
            </Expander>
            <Expander Header="_Output and replacement" Margin="0,12,0,0" AutomationProperties.AutomationId="OptimizationOutput">
                <StackPanel Margin="4,8">
                    <TextBlock Text="{Binding OutputNotice}" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <CheckBox Content="_Replace originals for this batch" IsEnabled="{Binding CanReplaceOriginal}"
                              IsChecked="{Binding ReplaceOriginal}" AutomationProperties.AutomationId="ReplaceOptimizationOriginals" />
                    <TextBlock Text="{Binding ReplacementNotice}" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </Expander>
            <CheckBox IsChecked="{Binding ReplacementConfirmed}" Margin="0,12,0,0"
                      Visibility="{Binding ReplaceOriginal, Converter={StaticResource VisibleWhenTrue}}"
                      AutomationProperties.AutomationId="ConfirmOptimizationReplacement">
                <TextBlock Text="I consent to recycling originals after successful optimization. If recycling fails, keep the backup and show its location."
                           TextWrapping="Wrap" />
            </CheckBox>
        </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <ui:StatusTextBlock Text="{Binding TrialMessage}" TextWrapping="Wrap" Margin="0,0,0,12"
                                AutomationProperties.AutomationId="OptimizationTrialStatus"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{Binding LicenseActionLabel}" Click="OnLicense" Padding="18,7" Margin="0,0,8,0" AutomationProperties.AutomationId="OptimizationLicense" />
                <Button Content="_Optimize" Command="{Binding ConfirmCommand}" Padding="22,7" Margin="0,0,8,0"
                        AutomationProperties.Name="Start PNG optimization" AutomationProperties.AutomationId="ConfirmPngOptimization"/>
                <Button Content="Cancel" IsCancel="True" Click="Cancel_Click" Padding="18,7" AutomationProperties.AutomationId="CancelPngOptimization"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
